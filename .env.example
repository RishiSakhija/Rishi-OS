# ============================================================
# Rishi-OS — Environment Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   PowerShell:  Copy-Item .env.example .env
# ============================================================

# ---- Supabase (the single datahouse: 7 tables) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ---- Model Router: Provider A -> B -> C -> Local ----
# A: DeepSeek (primary), NVIDIA NIM (A-fallback)
DEEPSEEK_API_KEY=your-deepseek-api-key
NVIDIA_API_KEY=your-nvidia-nim-api-key
# B: Google Gemini
GEMINI_API_KEY=your-gemini-api-key
# C: Groq
GROQ_API_KEY=your-groq-api-key
# Local: Ollama (last resort, keyless)
OLLAMA_BASE_URL=http://localhost:11434

# ---- Research / Search ----
TAVILY_API_KEY=your-tavily-api-key

# ---- Control Room (Streamlit) ----
DASHBOARD_PASSWORD=choose-a-strong-dashboard-password
